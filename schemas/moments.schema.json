{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "moments.json",
  "type": "object",
  "required": ["moments", "has_360"],
  "properties": {
    "has_360": {"type": "boolean"},
    "names": {"type": "object", "additionalProperties": {"type": "string"}},
    "moments": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "type", "event_id", "period", "minute", "second", "clock", "team", "team_name", "player",
                   "is_goal", "is_penalty", "xg_statsbomb", "xg_model", "outcome", "sequence", "snapshots", "facts",
                   "explanation", "highlights_url"],
      "properties": {
        "id": {"type": "string", "pattern": "^m[0-9]{2,}$"},
        "type": {"enum": ["goal", "own_goal", "penalty", "red_card", "shot"]},
        "event_id": {"type": "string"},
        "period": {"type": "integer", "minimum": 1, "maximum": 4},
        "minute": {"type": "integer", "minimum": 0}, "second": {"type": "integer", "minimum": 0, "maximum": 59},
        "clock": {"type": "string", "pattern": "^[0-9]+:[0-9]{2}$"},
        "team": {"enum": ["home", "away"]}, "team_name": {"type": "string"},
        "player": {"type": ["string", "null"]},
        "is_goal": {"type": "boolean"}, "is_penalty": {"type": "boolean"},
        "xg_statsbomb": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "xg_model": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "outcome": {"type": ["string", "null"]},
        "sequence": {"type": "array", "maxItems": 13, "items": {
          "type": "object", "required": ["kind", "event_id", "from", "to", "player", "t", "key"],
          "properties": {
            "kind": {"enum": ["pass", "carry", "shot"]}, "event_id": {"type": "string"},
            "from": {"$ref": "#/$defs/point"}, "to": {"$ref": "#/$defs/point"},
            "player": {"type": ["string", "null"]}, "recipient": {"type": ["string", "null"]},
            "t": {"type": "number", "minimum": 0}, "dur": {"type": ["number", "null"], "minimum": 0}, "key": {"type": "boolean"},
            "outcome": {"type": ["string", "null"]}}}},
        "movement": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["t_start", "t_end", "tracks", "quality"], "properties": {
          "t_start": {"type": "number"}, "t_end": {"type": "number"},
          "quality": {"type": "object", "required": ["snapshots", "tracks", "avg_visible", "max_gap_s", "max_speed"]},
          "tracks": {"type": "array", "items": {"type": "object", "required": ["id", "side", "keeper", "name", "jersey", "pts"], "properties": {
            "id": {"type": "string"}, "side": {"enum": ["att", "def"]}, "keeper": {"type": "boolean"},
            "name": {"type": ["string", "null"]}, "jersey": {"type": ["integer", "null"]},
            "pts": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}}}}}}}]},
        "snapshots": {"type": "object", "required": ["key_pass", "shot"], "properties": {
          "key_pass": {"$ref": "#/$defs/snapshot"}, "shot": {"$ref": "#/$defs/snapshot"}}},
        "facts": {"type": "object"},
        "explanation": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["text", "why", "source", "label"],
          "properties": {"text": {"type": "string"}, "why": {"type": "string"}, "speech": {"type": "string"}, "source": {"enum": ["template", "llm"]},
                         "label": {"const": "Automated analysis"}}}]},
        "highlights_url": {"type": ["string", "null"]}
      }}}
  },
  "$defs": {
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "snapshot": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["players", "offside_line_x"], "properties": {
      "offside_line_x": {"type": ["number", "null"]},
      "players": {"type": "array", "items": {"type": "object", "required": ["x", "y", "role"], "properties": {
        "x": {"type": "number"}, "y": {"type": "number"}, "actor": {"type": "boolean"},
        "role": {"enum": ["attacker", "defender", "keeper", "own_keeper"]}}}}}}]}
  }
}
