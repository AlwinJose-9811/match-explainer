{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "summary.json",
  "type": "object",
  "required": ["match_id", "competition", "season", "date", "teams", "score", "possession", "stats", "story"],
  "properties": {
    "match_id": {"type": "integer"},
    "competition": {"type": "string"},
    "season": {"type": "string"},
    "stage": {"type": ["string", "null"]},
    "date": {"type": "string"},
    "teams": {
      "type": "object", "required": ["home", "away"],
      "properties": {"home": {"$ref": "#/$defs/team"}, "away": {"$ref": "#/$defs/team"}}
    },
    "score": {
      "type": "object", "required": ["home", "away", "shootout"],
      "properties": {
        "home": {"type": "integer", "minimum": 0},
        "away": {"type": "integer", "minimum": 0},
        "shootout": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["home", "away"],
          "properties": {"home": {"type": "integer"}, "away": {"type": "integer"}}}]},
        "note": {"type": ["string", "null"]}
      }
    },
    "possession": {
      "type": "object", "required": ["method", "home", "away"],
      "properties": {"method": {"type": "string", "minLength": 1},
                     "home": {"type": "number", "minimum": 0, "maximum": 1},
                     "away": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "stats": {
      "type": "object", "required": ["home", "away"],
      "properties": {"home": {"$ref": "#/$defs/stats"}, "away": {"$ref": "#/$defs/stats"}}
    },
    "story": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["text", "label"],
      "properties": {"text": {"type": "string"}, "speech": {"type": "string"}, "audio": {"type": "string"}, "label": {"const": "Automated analysis"}}}]}
  },
  "$defs": {
    "team": {"type": "object", "required": ["id", "name", "color"],
      "properties": {"id": {"type": "integer"}, "name": {"type": "string"},
                     "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}}},
    "stats": {"type": "object",
      "required": ["shots", "on_target", "passes", "passes_completed", "pass_accuracy", "xg_model",
                   "xg_statsbomb", "fouls", "corners", "yellow", "red"],
      "properties": {
        "shots": {"type": "integer", "minimum": 0}, "on_target": {"type": "integer", "minimum": 0},
        "passes": {"type": "integer", "minimum": 0}, "passes_completed": {"type": "integer", "minimum": 0},
        "pass_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "xg_model": {"type": ["number", "null"], "minimum": 0},
        "xg_statsbomb": {"type": "number", "minimum": 0},
        "fouls": {"type": "integer", "minimum": 0}, "corners": {"type": "integer", "minimum": 0},
        "yellow": {"type": "integer", "minimum": 0}, "red": {"type": "integer", "minimum": 0}
      }}
  }
}
